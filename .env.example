# Copy to .env for local runs. Never commit real secrets.
# On Render (service concho-proof-builder), set the same keys in the Dashboard.
# In a Blueprint, mark secrets sync: false so the value stays in the Dashboard
# and is not written into git. See README.md.

# Required. HubSpot private-app token used by deal reads and Ready.
HUBSPOT_PROOF_BUILDER_TOKEN=

# Optional. Origin written into proof_builder_link during backfill.
# PUBLIC_URL=https://concho-proof-builder.onrender.com

# Optional. Portal id in the Ready notification deal link.
# HUBSPOT_PORTAL_ID=246719359

# Optional. Inbox for the Ready notification. Defaults to jake@conchousa.com.
# READY_NOTIFY_EMAIL=jake@conchousa.com

# Required to send. Verified Resend sender (domain must be verified in Resend).
# Placeholder only — replace in the Render Dashboard, not in git.
READY_NOTIFY_FROM=

# Required to send. Resend API key (https://resend.com/api-keys).
# Placeholder only. Render Blueprint form:
#   - key: RESEND_API_KEY
#     sync: false
RESEND_API_KEY=
