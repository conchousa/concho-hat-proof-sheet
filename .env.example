# Copy to .env for local runs. Never commit real secrets.
# Ready @mentions Jake Connell in HubSpot and assigns him the task.
# That path uses HUBSPOT_PROOF_BUILDER_TOKEN only. No new keys.

# Required. HubSpot private-app token used by deal reads and Ready.
HUBSPOT_PROOF_BUILDER_TOKEN=

# Optional. Origin written into proof_builder_link during backfill.
# PUBLIC_URL=https://concho-proof-builder.onrender.com

# Optional Resend copy. Both must be set or Ready does not call Resend.
# The default notice is the HubSpot @mention, which does not use these.
# READY_NOTIFY_EMAIL=jake@conchousa.com
# READY_NOTIFY_FROM=Concho Proof Builder <proofs@conchousa.com>
# RESEND_API_KEY=
# HUBSPOT_PORTAL_ID=246719359
